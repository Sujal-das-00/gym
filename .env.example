# MySQL connection for the gym backend
DB_HOST=localhost
DB_PORT=3306
DB_USER=SDAS
DB_PASSWORD=Sujal@123
DB_NAME=gym_admin

# Alternative single URL form supported by mysql2:
# DATABASE_URL=mysql://root:password@localhost:3306/gym_admin

PORT=5051

# Public site URL. PRODUCTION: set to your domain (change this one line if the
# domain ever changes). LOCAL DEV: leave it commented out / empty and the server
# builds links from the request host (http://localhost:5051).
# APP_BASE_URL=https://gymbot.toolszila.com

# Multi-tenant auth requires MySQL. Fail loudly instead of using the JSON fallback.
REQUIRE_DB=true

# --- Authentication / multi-tenant ---
# Secret used to sign login tokens (any long random string). Keep it private and stable.
JWT_SECRET=replace-with-a-long-random-secret
# Platform owner login, created on first boot (super-admin who provisions gyms).
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME=Platform Owner
# Send the session cookie only over HTTPS: false for local http, true in production.
COOKIE_SECURE=false

# Member "Account" login (gym_id + phone). All optional — sensible defaults apply.
# MEMBER_AUTH_COOKIE_NAME=gym_member_session
# MEMBER_AUTH_TOKEN_TTL=2592000       # 30 days, "trust this device" checked
# MEMBER_AUTH_TOKEN_TTL_UNTRUSTED=43200  # 12 hours, unchecked
# --- Web Push notifications (VAPID) ---
# Generate a pair once, per deployment, and keep them stable — rotating them
# invalidates every subscription members have already registered:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Only the PUBLIC key is ever sent to a browser (GET /api/push/public-key).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the key owner, required by the push services: mailto: or https URL.
VAPID_SUBJECT=mailto:support@gymboo.app
